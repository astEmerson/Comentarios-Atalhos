# Copie para .env (na pasta deste projeto ou na pasta acima) e preencha.
# Nao commite o .env. Ele guarda a senha do banco.

# String do botao Connect do Neon, com Connection pooling ligado.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require"

# Opcional. A mesma string com Connection pooling desligado.
# Se ficar vazia, o programa deriva a conexao direta a partir da DATABASE_URL.
DATABASE_URL_DIRECT=""

# Chave da OpenAI. Uma só, usada por todos os perfis. Nao commite o valor real.
OPENAI_API_KEY=""
